{
  "name": "framework-playwright-espanol",
  "version": "1.0.0",
  "description": "Mini framework de pruebas UI y API con Playwright",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:visible": "playwright test --headed",
    "test:inicio-sesion": "playwright test tests/ui/inicio-sesion.spec.js --headed --project=chromium",
    "test:api": "playwright test --project=api",
    "panel": "node servidor.js",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regresion": "playwright test --grep-invert @smoke",
    "reporte": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
